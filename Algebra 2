const SHEET_URL = 'https://script.google.com/macros/s/AKfycbzGwQNy9QcikDheuK4FOSo8rw2mVNnYW0vGAzGS0yvQhd9Tf-dIRlBFgFDqPvWc5cFwkQ/exec';

async function submitScore(){
  const name = document.getElementById('student-name').value.trim();
  const msg  = document.getElementById('submit-msg');
  const btn  = document.getElementById('submit-btn');
  if(!name){ msg.className='submit-msg err'; msg.textContent='⚠ Please enter your name first.'; return; }
  if(total===0){ msg.className='submit-msg err'; msg.textContent='⚠ Complete at least 1 problem first.'; return; }
  if(SHEET_URL==='YOUR_APPS_SCRIPT_URL_HERE'){
    msg.className='submit-msg err'; msg.textContent='⚠ Teacher: please add the Apps Script URL to the site.'; return;
  }
  btn.disabled=true; msg.className='submit-msg'; msg.textContent='Sending…';
  const pct = total?Math.round(correct/total*100):0;
  const payload = {
    name,
    topic: topics[currentTopic].label,
    difficulty,
    attempted: total,
    correct,
    accuracy: pct+'%',
    time: new Date().toLocaleString()
  };
  try {
    await fetch(SHEET_URL, {
      method:'POST', mode:'no-cors',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify(payload)
    });
    msg.className='submit-msg ok';
    msg.textContent=`✓ Score submitted! (${total} attempted, ${correct} correct, ${pct}%)`;
  } catch(e) {
    msg.className='submit-msg err';
    msg.textContent='✗ Could not send. Check your internet connection.';
  }
  btn.disabled=false;
}

