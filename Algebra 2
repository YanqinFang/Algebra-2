<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Algebra 1 Math Generator</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f5f5f5; color: #111; min-height: 100vh; padding: 2rem 1rem; font-size: 17px; }
    .app { max-width: 720px; margin: 0 auto; }
    h1 { font-size: 32px; font-weight: 600; color: #1a237e; margin-bottom: 6px; }
    .subtitle { font-size: 17px; color: #555; margin-bottom: 1.5rem; }

    .stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 1.5rem; }
    .stat { background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 16px; text-align: center; }
    .stat-num { font-size: 30px; font-weight: 600; color: #1a237e; }
    .stat-lbl { font-size: 14px; color: #888; margin-top: 2px; }

    .controls { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1rem; align-items: center; }
    select { padding: 10px 16px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; background: #fff; color: #111; }
    .btn { padding: 10px 20px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; cursor: pointer; background: #fff; color: #111; }
    .btn:hover { background: #f0f0f0; }
    .btn-primary { background: #1a237e; color: #fff; border-color: #1a237e; }
    .btn-primary:hover { background: #283593; }
    .btn-example { background: #fff8e1; color: #f57f17; border-color: #ffe082; font-weight: 500; }
    .btn-example:hover { background: #fff3cd; }

    .difficulty-row { display: flex; gap: 8px; margin-bottom: 1.5rem; }
    .diff-btn { flex: 1; padding: 10px; border: 2px solid #ddd; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; background: #fff; }
    .diff-btn.easy   { color: #2e7d32; border-color: #a5d6a7; }
    .diff-btn.medium { color: #e65100; border-color: #ffcc80; }
    .diff-btn.hard   { color: #b71c1c; border-color: #ef9a9a; }
    .diff-btn.easy.active   { background: #e8f5e9; border-color: #2e7d32; }
    .diff-btn.medium.active { background: #fff3e0; border-color: #e65100; }
    .diff-btn.hard.active   { background: #ffebee; border-color: #b71c1c; }

    /* Example panel */
    .example-panel { background: #fffde7; border: 1.5px solid #ffe082; border-radius: 12px; padding: 1.4rem 1.6rem; margin-bottom: 1.25rem; display: none; }
    .example-panel.open { display: block; }
    .example-title { font-size: 18px; font-weight: 600; color: #f57f17; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; }
    .example-close { cursor: pointer; font-size: 22px; color: #aaa; line-height: 1; }
    .example-close:hover { color: #555; }
    .example-problem { font-size: 19px; font-weight: 500; color: #111; margin-bottom: 0.75rem; white-space: pre-line; }
    .example-steps { list-style: none; }
    .example-steps li { font-size: 17px; color: #333; padding: 7px 0; border-bottom: 1px dashed #ffe082; line-height: 1.7; white-space: pre-line; }
    .example-steps li:last-child { border-bottom: none; }
    .step-label { display: inline-block; background: #fff8e1; border: 1px solid #ffe082; border-radius: 6px; font-size: 14px; font-weight: 600; color: #f57f17; padding: 2px 10px; margin-right: 8px; }
    .answer-line { margin-top: 10px; font-weight: 600; color: #1a237e; font-size: 18px; }

    .card { background: #fff; border: 1px solid #ddd; border-radius: 12px; padding: 1.6rem; margin-bottom: 1rem; }
    .badges { display: flex; gap: 8px; margin-bottom: 1rem; align-items: center; }
    .topic-badge { display: inline-block; font-size: 14px; padding: 4px 14px; border-radius: 20px; background: #e8eaf6; color: #1a237e; font-weight: 500; }
    .diff-badge { display: inline-block; font-size: 14px; padding: 4px 14px; border-radius: 20px; font-weight: 500; }
    .diff-badge.easy   { background: #e8f5e9; color: #2e7d32; }
    .diff-badge.medium { background: #fff3e0; color: #e65100; }
    .diff-badge.hard   { background: #ffebee; color: #b71c1c; }

    .problem-text { font-size: 22px; font-weight: 500; color: #111; margin-bottom: 1.25rem; line-height: 1.7; white-space: pre-line; }
    .input-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .answer-input { padding: 12px 16px; border: 1px solid #ccc; border-radius: 8px; font-size: 17px; width: 240px; }
    .answer-input:focus { outline: none; border-color: #1a237e; box-shadow: 0 0 0 2px rgba(26,35,126,0.15); }

    .hint-link { font-size: 15px; color: #1a237e; cursor: pointer; text-decoration: underline; margin-top: 10px; display: none; }
    .hint { margin-top: 10px; padding: 12px 16px; border-left: 3px solid #9fa8da; background: #f5f5f5; font-size: 16px; color: #444; border-radius: 0 8px 8px 0; display: none; white-space: pre-line; }
    .feedback { margin-top: 12px; padding: 12px 16px; border-radius: 8px; font-size: 17px; display: none; }
    .feedback.correct { background: #e8f5e9; color: #2e7d32; display: block; }
    .feedback.wrong   { background: #ffebee; color: #c62828; display: block; }
    .footer { text-align: center; margin-top: 2rem; font-size: 15px; color: #aaa; }
    /* Concept box */
    .concept-box { background: #e8eaf6; border: 1.5px solid #9fa8da; border-radius: 12px; padding: 1.2rem 1.4rem; margin-bottom: 1.2rem; }
    .concept-header { font-size: 17px; font-weight: 700; color: #1a237e; margin-bottom: 0.8rem; }
    .concept-rule { background: #fff; border-left: 4px solid #1a237e; padding: 10px 14px; border-radius: 0 8px 8px 0; font-size: 14px; color: #333; margin-bottom: 0.8rem; line-height: 1.7; white-space: pre-line; }
    .concept-example-title { font-size: 14px; font-weight: 700; color: #f57f17; margin: 8px 0 4px; }
    .concept-example-prob { font-size: 15px; font-weight: 500; color: #111; margin-bottom: 6px; white-space: pre-line; }
    .concept-steps { list-style: none; }
    .concept-steps li { font-size: 14px; padding: 5px 0; border-bottom: 1px dashed #c5cae9; line-height: 1.6; white-space: pre-line; }
    .concept-steps li:last-child { border-bottom: none; }
    .concept-answer { font-weight: 700; color: #1a237e; font-size: 15px; margin-top: 8px; }
    /* Multiple choice */
    .mc-options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1rem; }
    .mc-opt { display: flex; align-items: center; gap: 14px; padding: 14px 18px; border: 2px solid #ddd; border-radius: 10px; cursor: pointer; font-size: 17px; transition: all .15s; background: #fff; line-height: 1.5; }
    .mc-opt:hover:not(.locked) { border-color: #9fa8da; background: #f5f5f5; }
    .mc-opt.selected { border-color: #1a237e; background: #e8eaf6; }
    .mc-opt.correct { border-color: #2e7d32 !important; background: #e8f5e9 !important; font-weight: 600; color: #2e7d32; }
    .mc-opt.wrong { border-color: #c62828 !important; background: #ffebee !important; color: #c62828; }
    .mc-opt.reveal { border-color: #2e7d32 !important; background: #e8f5e9 !important; }
    .mc-label { display: inline-flex; align-items: center; justify-content: center; min-width: 30px; height: 30px; border-radius: 50%; background: #e8eaf6; color: #1a237e; font-weight: 700; font-size: 14px; flex-shrink: 0; }
    .mc-opt.correct .mc-label { background: #2e7d32; color: #fff; }
    .mc-opt.wrong .mc-label { background: #c62828; color: #fff; }
    .mc-opt.reveal .mc-label { background: #2e7d32; color: #fff; }
    .mc-opt.locked { cursor: default; }
  </style>
</head>
<body>
<div class="app">
  <h1>Algebra 1 Problem Generator</h1>
  <p class="subtitle">Select a topic and difficulty, then press New Problem</p>

  <div class="stats">
    <div class="stat"><div class="stat-num" id="s-total">0</div><div class="stat-lbl">attempted</div></div>
    <div class="stat"><div class="stat-num" id="s-correct">0</div><div class="stat-lbl">correct</div></div>
    <div class="stat"><div class="stat-num" id="s-pct">—</div><div class="stat-lbl">accuracy</div></div>
  </div>

  <div class="controls">
    <select id="topic" onchange="setTopic(this.value)">
      <option value="factor">Solve by factoring</option>
      <option value="quadformula">Quadratic formula</option>
      <option value="complete">Complete the square</option>
      <option value="discriminant">Discriminant</option>
      <option value="system">Linear-quadratic systems</option>
    </select>
    <button class="btn btn-primary" onclick="newProblem()">↻ New Problem</button>
    <button class="btn" onclick="resetStats()">✕ Reset</button>
  </div>

  <div class="difficulty-row">
    <button class="diff-btn easy active" onclick="setDiff('easy')">⭐ Easy</button>
    <button class="diff-btn medium" onclick="setDiff('medium')">⭐⭐ Medium</button>
    <button class="diff-btn hard" onclick="setDiff('hard')">⭐⭐⭐ Hard</button>
  </div>

  <!-- Concept box — always visible, updates on topic change -->
  <div class="concept-box" id="concept-box"></div>

  <!-- Practice card -->
  <div class="card">
    <div class="badges">
      <span class="topic-badge" id="badge-topic">Factoring</span>
      <span class="diff-badge easy" id="badge-diff">Easy</span>
    </div>
    <div class="problem-text" id="prob">Press "New Problem" to start</div>
    <div class="mc-options" id="mc-options"></div>
    <span class="hint-link" id="hint-link" onclick="showHint()">Show hint</span>
    <div class="hint" id="hint"></div>
    <div class="feedback" id="feedback"></div>
  </div>

  <div class="footer">Algebra 1 Math Generator — YanqinFang</div>
</div>

<script>
let current = null, total = 0, correct = 0, difficulty = 'easy';
let mcCorrect = null, mcAnswered = false;

function pick(arr) { return arr[Math.floor(Math.random()*arr.length)]; }
function fmt(n) { return Math.round(n*100)/100; }
function bStr(b) { return b===0?'':(b>0?` + ${b}x`:` - ${Math.abs(b)}x`); }
function cStr(c) { return c===0?'':(c>0?` + ${c}`:` - ${Math.abs(c)}`); }

// ── Worked examples (one per topic) ─────────────────────────────────────────
const examples = {
  factor: {
    problem: 'Solve by factoring:\n  x² + x − 6 = 0',
    steps: [
      ['Find two numbers', 'We need two numbers that multiply to −6 and add to +1.\n  Try: 3 × (−2) = −6  ✓  and  3 + (−2) = 1  ✓'],
      ['Write the factors', '(x + 3)(x − 2) = 0'],
      ['Zero Product Property', 'x + 3 = 0   →   x = −3\nx − 2 = 0   →   x = 2'],
    ],
    answer: 'Answer:  x = −3  or  x = 2'
  },
  quadformula: {
    problem: 'Use the quadratic formula to solve:\n  2x² − 3x − 5 = 0',
    steps: [
      ['Identify a, b, c', 'a = 2,   b = −3,   c = −5'],
      ['Compute discriminant', 'b² − 4ac = (−3)² − 4(2)(−5)\n= 9 + 40 = 49'],
      ['Apply the formula', 'x = (−b ± √49) / 2a\n= (3 ± 7) / 4'],
      ['Two solutions', 'x = (3 + 7)/4 = 10/4 = 5/2\nx = (3 − 7)/4 = −4/4 = −1'],
    ],
    answer: 'Answer:  x = 5/2  or  x = −1'
  },
  complete: {
    problem: 'Complete the square to solve:\n  x² + 6x − 7 = 0\nAlso state the vertex.',
    steps: [
      ['Move constant', 'x² + 6x = 7'],
      ['Half of b, then square', '(6/2)² = 3² = 9   →   add 9 to both sides'],
      ['Perfect square', 'x² + 6x + 9 = 16\n(x + 3)² = 16'],
      ['Square root both sides', 'x + 3 = ±4'],
      ['Solve', 'x = −3 + 4 = 1   or   x = −3 − 4 = −7'],
      ['Vertex', 'Vertex x = −3,   y = (−3)² + 6(−3) − 7 = −16\nVertex: (−3, −16)'],
    ],
    answer: 'Answer:  x = 1 or x = −7   |   Vertex: (−3, −16)'
  },
  discriminant: {
    problem: 'How many real solutions?\n  x² − 4x + 4 = 0',
    steps: [
      ['Identify a, b, c', 'a = 1,   b = −4,   c = 4'],
      ['Compute discriminant', 'b² − 4ac = (−4)² − 4(1)(4)\n= 16 − 16 = 0'],
      ['Interpret', 'Discriminant = 0\n→ Exactly ONE real solution (repeated root)'],
    ],
    answer: 'Answer:  1 real solution   (x = 2)'
  },
  system: {
    problem: 'Solve the system:\n  y = x² − x − 2\n  y = x + 1',
    steps: [
      ['Substitute', 'Set the expressions equal:\nx² − x − 2 = x + 1'],
      ['Rearrange', 'x² − 2x − 3 = 0'],
      ['Factor', '(x − 3)(x + 1) = 0\nx = 3   or   x = −1'],
      ['Find y values', 'x = 3:   y = 3 + 1 = 4   →   (3, 4)\nx = −1:  y = −1 + 1 = 0   →   (−1, 0)'],
      ['Check (3, 4)', '4 = 3² − 3 − 2 = 4  ✓   and   4 = 3 + 1 = 4  ✓'],
    ],
    answer: 'Answer:  (3, 4)  and  (−1, 0)'
  }
};

const rules = {
  factor:
`Steps to Solve by Factoring:
1. Write the equation as ax² + bx + c = 0
2. Find two numbers that multiply to a·c and add to b
3. Factor into two binomials
4. Zero Product Property: set each factor = 0 and solve`,
  quadformula:
`Quadratic Formula — for ax² + bx + c = 0:
         −b ± √(b²−4ac)
   x  =  ───────────────
                2a
Discriminant (b²−4ac):
  > 0 → 2 real solutions
  = 0 → 1 repeated solution
  < 0 → no real solutions`,
  complete:
`Completing the Square — x² + bx + c = 0:
1. Move c to the right side: x² + bx = −c
2. Add (b/2)² to BOTH sides
3. Left side becomes a perfect square: (x + b/2)²
4. Take the square root of both sides, then solve
Vertex of y = x² + bx + c:  h = −b/2,  k = f(h)`,
  discriminant:
`Discriminant = b² − 4ac   (for ax² + bx + c = 0)
  b²−4ac > 0  →  2 distinct real solutions
  b²−4ac = 0  →  1 repeated real solution
  b²−4ac < 0  →  no real solutions (imaginary)`,
  system:
`Solving a Linear-Quadratic System:
  { y = quadratic
  { y = linear
1. Set the two expressions equal to each other
2. Rearrange into standard form and solve
3. Substitute x back to find each y
4. Write answers as ordered pairs (x, y)`
};

function setTopic(val) { renderConcept(val); newProblem(); }

function renderConcept(val) {
  const box = document.getElementById('concept-box');
  if (!box) return;
  const rule = rules[val] || '';
  const ex = examples[val];
  const lbl = topics[val] ? topics[val].label : val;
  const stepsHtml = ex.steps.map(([l,t]) =>
    `<li><span class="step-label">${l}</span>${t.replace(/\n/g,'<br>')}</li>`
  ).join('');
  box.innerHTML = `
    <div class="concept-header">📚 ${lbl}</div>
    <div class="concept-rule">${rule}</div>
    <div class="concept-example-title">📖 Worked Example</div>
    <div class="concept-example-prob">${ex.problem.replace(/\n/g,'<br>')}</div>
    <ul class="concept-steps">${stepsHtml}</ul>
    <div class="concept-answer">${ex.answer}</div>
  `;
}

// ── Difficulty config ────────────────────────────────────────────────────────
const cfg = {
  easy:   { roots:[-3,-2,-1,1,2,3], a:[1], hR:[-2,-1,1,2], kR:[-4,0,4], sR:[-2,-1,1,2], m:[1,-1,2], bl:[-2,0,2] },
  medium: { roots:[-5,-4,-3,-2,-1,1,2,3,4,5], a:[1,1,2], hR:[-4,-3,-2,-1,1,2,3,4], kR:[-9,-4,-1,0,1,4,9], sR:[-3,-2,-1,1,2,3], m:[-3,-2,-1,1,2,3], bl:[-4,-2,0,2,4] },
  hard:   { roots:[-6,-5,-4,-3,-2,-1,1,2,3,4,5,6], a:[2,3,4,5], hR:[-5,-4,-3,-2,-1,1,2,3,4,5], kR:[-16,-9,-4,-1,0,1,4,9,16,25], sR:[-4,-3,-2,-1,1,2,3,4], m:[-5,-4,-3,-2,-1,1,2,3,4,5], bl:[-6,-4,-2,0,2,4,6] }
};

// ── Problem generators ───────────────────────────────────────────────────────
const topics = {
  factor: {
    label:'Solve by factoring',
    gen(d) {
      const c = cfg[d];
      const a = d==='hard'?pick([2,3,4]):1;
      const r1=pick(c.roots), r2=pick(c.roots);
      const B=-a*(r1+r2), C=a*r1*r2;
      const aStr=a===1?'':a;
      const hint=`Look for two numbers that multiply to ${C} and add to ${B}.`;
      return { text:`Solve by factoring:\n  ${aStr}x²${bStr(B)}${cStr(C)} = 0`, answers:[r1,r2], hint };
    }
  },
  quadformula: {
    label:'Quadratic formula',
    gen(d) {
      const c = cfg[d];
      const a=pick(c.a);
      if (d==='hard') {
        const b2=pick([-5,-3,-1,1,3,5]), c2=pick([-7,-5,-3,-1,1,2]);
        const disc=b2*b2-4*a*c2;
        const aStr=a===1?'':a;
        let ans;
        if(disc<0) ans=[];
        else if(disc===0) ans=[fmt(-b2/(2*a))];
        else { const sq=Math.sqrt(disc); ans=[fmt((-b2+sq)/(2*a)),fmt((-b2-sq)/(2*a))]; }
        const hint=`a=${a}, b=${b2}, c=${c2}\nDiscriminant = ${b2}²−4(${a})(${c2}) = ${disc}`;
        return { text:`Quadratic formula (round to nearest hundredth):\n  ${aStr}x²${bStr(b2)}${cStr(c2)} = 0`, answers:ans, hint, irrational:true };
      }
      const r1=pick(c.roots), r2=pick(c.roots);
      const B=-a*(r1+r2), C=a*r1*r2;
      const aStr=a===1?'':a;
      const disc=B*B-4*a*C;
      const hint=`a=${a}, b=${B}, c=${C}\nDiscriminant = ${B}²−4(${a})(${C}) = ${disc}\nx = (−(${B}) ± √${disc}) / ${2*a}`;
      return { text:`Use the quadratic formula:\n  ${aStr}x²${bStr(B)}${cStr(C)} = 0`, answers:[r1,r2], hint };
    }
  },
  complete: {
    label:'Complete the square',
    gen(d) {
      const c=cfg[d];
      const h=pick(c.hR), k=pick(c.kR);
      const b=-2*h, cv=h*h+k;
      const disc=h*h-k;
      let ans;
      if(disc<0) ans=[];
      else if(disc===0) ans=[h];
      else { const sq=Math.sqrt(disc); ans=[fmt(h+sq),fmt(h-sq)]; }
      const hint=`Step 1: x²${bStr(b)} = ${-cv}\nStep 2: Add (${b}/2)² = ${h*h} to both sides\nStep 3: (x ${h>=0?'− '+h:'+ '+Math.abs(h)})² = ${-k}\nVertex: (${h}, ${k})`;
      return { text:`Complete the square:\n  x²${bStr(b)}${cStr(cv)} = 0\n\nAlso state the vertex.`, answers:ans, hint, vertex:`(${h}, ${k})` };
    }
  },
  discriminant: {
    label:'Discriminant',
    gen(d) {
      const type=pick(['two','two','one','none']);
      let a=d==='hard'?pick([2,3]):1, b, c, label;
      if(type==='two'){b=pick([-5,-4,-3,3,4,5]);c=pick([-6,-4,-3,-2,-1]);label='2 real solutions';}
      else if(type==='one'){b=pick([-6,-4,-2,2,4,6]);c=(b*b)/(4*a);label='1 real solution';}
      else{b=pick([-2,-1,1,2]);c=pick([5,6,8,10]);label='No real solutions';}
      const disc=b*b-4*a*c;
      const aStr=a===1?'':a;
      const hint=`Discriminant = b²−4ac\n= (${b})²−4(${a})(${c})\n= ${b*b}−${4*a*c}\n= ${disc}\n\n${disc>0?'> 0 → 2 real solutions':disc===0?'= 0 → 1 solution':'< 0 → No real solutions'}`;
      return { text:`How many real solutions?\n  ${aStr}x²${bStr(b)}${cStr(c)} = 0`, answers:[label], hint };
    }
  },
  system: {
    label:'Linear-quadratic system',
    gen(d) {
      const c=cfg[d];
      const x1=pick(c.sR), x2=pick(c.sR);
      const m=pick(c.m), bl=pick(c.bl);
      const y1=m*x1+bl, y2=m*x2+bl;
      const B=-(x1+x2), C=x1*x2;
      const mStr=m===1?'':(m===-1?'-':m);
      const blStr=bl===0?'':(bl>0?` + ${bl}`:` − ${Math.abs(bl)}`);
      const hint=`Substitute y = ${mStr}x${blStr} into the quadratic.\nRearrange and solve for x, then find y.`;
      return { text:`Solve the system:\n  y = x²${bStr(B)}${cStr(C)}\n  y = ${mStr}x${blStr}`, answers:[[x1,y1],[x2,y2]], hint };
    }
  }
};

// ── Multiple Choice engine ───────────────────────────────────────────────────
const MC_LABELS = ['A','B','C','D'];

function buildMC(cur, topic) {
  let ans_str, wrong = [];

  if (topic === 'factor' || topic === 'quadformula') {
    const a = cur.answers;
    if (a.length === 0) {
      ans_str = 'No real solutions';
      wrong = ['x = 1  or  x = −1', 'x = 0  or  x = −2', 'x = −3  or  x = 4'];
    } else if (a.length === 1) {
      ans_str = `x = ${fmt(a[0])}  (repeated root)`;
      wrong = [`x = ${fmt(-a[0])}  (repeated root)`, `x = ${fmt(a[0]+1)}  or  x = ${fmt(a[0]-1)}`, 'No real solutions'];
    } else {
      ans_str = `x = ${fmt(a[0])}  or  x = ${fmt(a[1])}`;
      wrong = [
        `x = ${fmt(-a[0])}  or  x = ${fmt(-a[1])}`,
        `x = ${fmt(a[0])}  or  x = ${fmt(a[1]+1)}`,
        `x = ${fmt(a[0]+1)}  or  x = ${fmt(a[1])}`
      ];
    }
  } else if (topic === 'complete') {
    const a = cur.answers, v = cur.vertex || '(?, ?)';
    const vParts = v.replace(/[()]/g,'').split(',').map(s=>parseInt(s.trim()));
    const [h, k] = vParts;
    let rootStr = a.length===0 ? 'No real solutions'
                : a.length===1 ? `x = ${fmt(a[0])}`
                : `x = ${fmt(a[0])}  or  x = ${fmt(a[1])}`;
    ans_str = `${rootStr}   |   Vertex: ${v}`;
    wrong = [
      `${rootStr}   |   Vertex: (${-h}, ${k})`,
      `${rootStr}   |   Vertex: (${h}, ${-k})`,
      a.length >= 2
        ? `x = ${fmt(-a[0])}  or  x = ${fmt(-a[1])}   |   Vertex: ${v}`
        : `x = ${fmt((a[0]||0)+1)}   |   Vertex: ${v}`
    ];
  } else if (topic === 'discriminant') {
    ans_str = cur.answers[0];
    wrong = ['2 real solutions','1 real solution','No real solutions','Infinitely many solutions']
              .filter(s => s !== ans_str);
  } else if (topic === 'system') {
    const pf = p => `(${fmt(p[0])}, ${fmt(p[1])})`;
    ans_str = cur.answers.map(pf).join('  and  ');
    wrong = [
      cur.answers.map(p=>`(${fmt(p[0]+1)}, ${fmt(p[1])})`).join('  and  '),
      cur.answers.map(p=>`(${fmt(p[0])}, ${fmt(p[1]+1)})`).join('  and  '),
      cur.answers.map(p=>`(${fmt(-p[0])}, ${fmt(-p[1])})`).join('  and  ')
    ];
  }

  const opts = [ans_str, ...wrong.slice(0,3)];
  for (let i = opts.length-1; i > 0; i--) {
    const j = Math.floor(Math.random()*(i+1));
    [opts[i], opts[j]] = [opts[j], opts[i]];
  }
  return { opts, ans_str };
}

function renderMC(cur, topic) {
  const { opts, ans_str } = buildMC(cur, topic);
  mcCorrect = ans_str;
  mcAnswered = false;
  const container = document.getElementById('mc-options');
  container.innerHTML = '';
  opts.forEach((opt, i) => {
    const div = document.createElement('div');
    div.className = 'mc-opt';
    div.innerHTML = `<span class="mc-label">${MC_LABELS[i]}</span><span>${opt}</span>`;
    div.onclick = () => {
      if (mcAnswered) return;
      mcAnswered = true;
      total++;
      const isOk = (opt === mcCorrect);
      if (isOk) correct++;
      updateStats();
      // style all options
      container.querySelectorAll('.mc-opt').forEach((el, j) => {
        el.classList.add('locked');
        if (opts[j] === mcCorrect) el.classList.add('reveal');
      });
      div.classList.remove('reveal');
      div.classList.add(isOk ? 'correct' : 'wrong');
      const fb = document.getElementById('feedback');
      fb.className = 'feedback ' + (isOk ? 'correct' : 'wrong');
      fb.innerHTML = isOk ? '✓ Correct!' : `✗ Not quite.  Correct answer: <b>${mcCorrect}</b>`;
    };
    container.appendChild(div);
  });
}

// ── UI ───────────────────────────────────────────────────────────────────────
function setDiff(d) {
  difficulty=d;
  document.querySelectorAll('.diff-btn').forEach(b=>b.classList.remove('active'));
  document.querySelector('.diff-btn.'+d).classList.add('active');
  const badge=document.getElementById('badge-diff');
  badge.className='diff-badge '+d;
  badge.textContent=d.charAt(0).toUpperCase()+d.slice(1);
  newProblem();
}

function showHint(){
  document.getElementById('hint').style.display='block';
  document.getElementById('hint').textContent=current.hint;
  document.getElementById('hint-link').style.display='none';
}

function newProblem(){
  const topic=document.getElementById('topic').value;
  current=topics[topic].gen(difficulty);
  document.getElementById('badge-topic').textContent=topics[topic].label;
  document.getElementById('prob').innerText=current.text;
  document.getElementById('feedback').className='feedback';
  document.getElementById('hint').style.display='none';
  document.getElementById('hint-link').style.display='inline';
  renderMC(current, topic);
}

function updateStats(){
  document.getElementById('s-total').textContent=total;
  document.getElementById('s-correct').textContent=correct;
  document.getElementById('s-pct').textContent=total?Math.round(correct/total*100)+'%':'—';
}

function resetStats(){ total=0; correct=0; updateStats(); newProblem(); }

setTopic('factor');
</script>
