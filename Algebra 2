<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quadratics &amp; Factoring Generator</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: system-ui, sans-serif; background: #f3f0ff; color: #111; min-height: 100vh; padding: 2rem 1rem; font-size: 17px; }
    .app { max-width: 760px; margin: 0 auto; }

    h1 { font-size: 30px; font-weight: 700; color: #4527a0; margin-bottom: 4px; }
    .subtitle { font-size: 16px; color: #666; margin-bottom: 1.5rem; }

    .stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 1.5rem; }
    .stat { background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 14px; text-align: center; }
    .stat-num { font-size: 28px; font-weight: 700; color: #4527a0; }
    .stat-lbl { font-size: 14px; color: #999; margin-top: 2px; }

    /* Section headers */
    .section-label { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #9e9e9e; margin-bottom: 6px; margin-top: 1rem; }

    /* Topic tabs — grouped */
    .group { margin-bottom: 1.2rem; }
    .group-title { font-size: 13px; font-weight: 700; color: #fff; padding: 4px 14px; border-radius: 20px; display: inline-block; margin-bottom: 6px; }
    .group-title.qt { background: #4527a0; }
    .group-title.fc { background: #00695c; }
    .tab-row { display: flex; gap: 6px; flex-wrap: wrap; }
    .tab { padding: 7px 13px; border: 2px solid #ddd; border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; background: #fff; transition: all .15s; }
    .tab.qt { color: #4527a0; border-color: #b39ddb; }
    .tab.qt:hover { background: #ede7f6; }
    .tab.qt.active { background: #4527a0; color: #fff; border-color: #4527a0; }
    .tab.fc { color: #00695c; border-color: #80cbc4; }
    .tab.fc:hover { background: #e0f2f1; }
    .tab.fc.active { background: #00695c; color: #fff; border-color: #00695c; }

    /* Difficulty */
    .diff-row { display: flex; gap: 8px; margin-bottom: 1.4rem; }
    .diff-btn { flex: 1; padding: 9px; border: 2px solid #ddd; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; background: #fff; }
    .diff-btn.easy   { color: #2e7d32; border-color: #a5d6a7; }
    .diff-btn.medium { color: #e65100; border-color: #ffcc80; }
    .diff-btn.hard   { color: #b71c1c; border-color: #ef9a9a; }
    .diff-btn.easy.active   { background: #e8f5e9; border-color: #2e7d32; }
    .diff-btn.medium.active { background: #fff3e0; border-color: #e65100; }
    .diff-btn.hard.active   { background: #ffebee; border-color: #b71c1c; }

    /* Controls */
    .controls { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1.3rem; }
    .btn { padding: 10px 20px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; cursor: pointer; background: #fff; color: #111; }
    .btn:hover { background: #f0f0f0; }
    .btn-primary { background: #4527a0; color: #fff; border-color: #4527a0; }
    .btn-primary:hover { background: #512da8; }
    .btn-primary.fc-active { background: #00695c; border-color: #00695c; }
    .btn-primary.fc-active:hover { background: #00796b; }
    .btn-example { background: #fff8e1; color: #f57f17; border-color: #ffe082; font-weight: 600; }
    .btn-example:hover { background: #fff3cd; }

    /* Example panel */
    .example-panel { background: #fffde7; border: 1.5px solid #ffe082; border-radius: 12px; padding: 1.4rem 1.6rem; margin-bottom: 1.2rem; display: none; }
    .example-panel.open { display: block; }
    .ex-title { font-size: 17px; font-weight: 700; color: #f57f17; margin-bottom: .75rem; display: flex; justify-content: space-between; align-items: center; }
    .ex-close { cursor: pointer; font-size: 22px; color: #bbb; }
    .ex-close:hover { color: #555; }
    .ex-problem { font-size: 18px; font-weight: 500; color: #111; margin-bottom: .75rem; white-space: pre-line; }
    .ex-steps { list-style: none; }
    .ex-steps li { font-size: 16px; color: #333; padding: 7px 0; border-bottom: 1px dashed #ffe082; line-height: 1.7; white-space: pre-line; }
    .ex-steps li:last-child { border-bottom: none; }
    .step-lbl { display: inline-block; background: #fff8e1; border: 1px solid #ffe082; border-radius: 6px; font-size: 13px; font-weight: 700; color: #f57f17; padding: 1px 9px; margin-right: 8px; }
    .ex-answer { margin-top: 10px; font-weight: 700; color: #4527a0; font-size: 17px; }

    /* Problem card */
    .card { background: #fff; border: 1px solid #ddd; border-radius: 12px; padding: 1.6rem; margin-bottom: 1rem; }
    .badges { display: flex; gap: 8px; margin-bottom: 1rem; flex-wrap: wrap; align-items: center; }
    .badge { display: inline-block; font-size: 13px; padding: 4px 13px; border-radius: 20px; font-weight: 600; }
    .badge-qt   { background: #ede7f6; color: #4527a0; }
    .badge-fc   { background: #e0f2f1; color: #00695c; }
    .badge-easy   { background: #e8f5e9; color: #2e7d32; }
    .badge-medium { background: #fff3e0; color: #e65100; }
    .badge-hard   { background: #ffebee; color: #b71c1c; }

    .problem-text { font-size: 22px; font-weight: 500; color: #111; margin-bottom: 1.25rem; line-height: 1.7; white-space: pre-line; }
    .input-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .answer-input { padding: 11px 15px; border: 1px solid #ccc; border-radius: 8px; font-size: 17px; min-width: 220px; flex: 1; max-width: 340px; }
    .answer-input:focus { outline: none; border-color: #4527a0; box-shadow: 0 0 0 2px rgba(69,39,160,.15); }

    .hint-link { font-size: 15px; color: #4527a0; cursor: pointer; text-decoration: underline; margin-top: 10px; display: none; }
    .hint { margin-top: 10px; padding: 12px 16px; border-left: 3px solid #b39ddb; background: #f5f5f5; font-size: 16px; color: #444; border-radius: 0 8px 8px 0; display: none; white-space: pre-line; }
    .feedback { margin-top: 12px; padding: 12px 16px; border-radius: 8px; font-size: 17px; display: none; }
    .feedback.correct { background: #e8f5e9; color: #2e7d32; display: block; }
    .feedback.wrong   { background: #ffebee; color: #c62828; display: block; }

    .footer { text-align: center; margin-top: 2rem; font-size: 14px; color: #bbb; }

    /* Student name bar */
    .name-bar { background: #fff; border: 1px solid #ddd; border-radius: 12px; padding: 14px 18px; margin-bottom: 1.2rem; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .name-bar label { font-size: 15px; font-weight: 600; color: #4527a0; white-space: nowrap; }
    .name-input { padding: 9px 14px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; flex: 1; min-width: 160px; max-width: 260px; }
    .name-input:focus { outline: none; border-color: #4527a0; box-shadow: 0 0 0 2px rgba(69,39,160,.15); }
    .btn-submit { padding: 9px 18px; border: none; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; background: #4527a0; color: #fff; }
    .btn-submit:hover { background: #512da8; }
    .btn-submit:disabled { background: #bbb; cursor: default; }
    .submit-msg { font-size: 14px; margin-top: 6px; width: 100%; }
    .submit-msg.ok  { color: #2e7d32; }
    .submit-msg.err { color: #c62828; }
  </style>
</head>
<body>
<div class="app">
  <h1>📐 Quadratics &amp; Factoring</h1>
  <p class="subtitle">Transformations · Vertex Form · Factoring — Easy to Hard</p>

  <!-- Student name + submit -->
  <div class="name-bar">
    <label>👤 Your name:</label>
    <input class="name-input" id="student-name" placeholder="First Last" />
    <button class="btn-submit" id="submit-btn" onclick="submitScore()">📤 Submit Score</button>
    <span class="submit-msg" id="submit-msg"></span>
  </div>

  <div class="stats">
    <div class="stat"><div class="stat-num" id="s-total">0</div><div class="stat-lbl">attempted</div></div>
    <div class="stat"><div class="stat-num" id="s-correct">0</div><div class="stat-lbl">correct</div></div>
    <div class="stat"><div class="stat-num" id="s-pct">—</div><div class="stat-lbl">accuracy</div></div>
  </div>

  <!-- Topic groups -->
  <div class="group">
    <span class="group-title qt">Quadratic Transformations</span>
    <div class="tab-row">
      <button class="tab qt active" data-topic="vertex" onclick="setTopic('vertex',this)">Vertex Form</button>
      <button class="tab qt" data-topic="stretch" onclick="setTopic('stretch',this)">Stretch / Compress / Reflect</button>
      <button class="tab qt" data-topic="shift" onclick="setTopic('shift',this)">Shifts</button>
      <button class="tab qt" data-topic="grapheq" onclick="setTopic('grapheq',this)">Graph → Equation</button>
    </div>
  </div>
  <div class="group">
    <span class="group-title fc">Factoring</span>
    <div class="tab-row">
      <button class="tab fc" data-topic="gcf" onclick="setTopic('gcf',this)">GCF</button>
      <button class="tab fc" data-topic="trinomial" onclick="setTopic('trinomial',this)">Trinomial x²+bx+c</button>
      <button class="tab fc" data-topic="diff2" onclick="setTopic('diff2',this)">Difference of Squares</button>
      <button class="tab fc" data-topic="leada" onclick="setTopic('leada',this)">ax²+bx+c</button>
    </div>
  </div>

  <!-- Difficulty -->
  <div class="diff-row">
    <button class="diff-btn easy active" onclick="setDiff('easy')">⭐ Easy</button>
    <button class="diff-btn medium" onclick="setDiff('medium')">⭐⭐ Medium</button>
    <button class="diff-btn hard" onclick="setDiff('hard')">⭐⭐⭐ Hard</button>
  </div>

  <!-- Buttons -->
  <div class="controls">
    <button class="btn btn-example" onclick="toggleExample()">📖 Show Example</button>
    <button class="btn btn-primary" id="new-btn" onclick="newProblem()">↻ New Problem</button>
    <button class="btn" onclick="resetStats()">✕ Reset</button>
  </div>

  <!-- Example panel -->
  <div class="example-panel" id="example-panel">
    <div class="ex-title">
      <span>📖 Worked Example</span>
      <span class="ex-close" onclick="closeExample()">✕</span>
    </div>
    <div class="ex-problem" id="ex-problem"></div>
    <ul class="ex-steps" id="ex-steps"></ul>
    <div class="ex-answer" id="ex-answer"></div>
  </div>

  <!-- Practice card -->
  <div class="card">
    <div class="badges">
      <span class="badge badge-qt" id="badge-topic">Vertex Form</span>
      <span class="badge badge-easy" id="badge-diff">Easy</span>
    </div>
    <div class="problem-text" id="prob">Press "New Problem" to start</div>
    <div class="input-row">
      <input class="answer-input" id="ans" placeholder="Type your answer" onkeydown="if(event.key==='Enter')checkAnswer()">
      <button class="btn btn-primary" id="check-btn" onclick="checkAnswer()">✓ Check</button>
    </div>
    <span class="hint-link" id="hint-link" onclick="showHint()">Show hint</span>
    <div class="hint" id="hint"></div>
    <div class="feedback" id="feedback"></div>
  </div>

  <div class="footer">Quadratics &amp; Factoring Generator — YanqinFang</div>
</div>

<script>
let current = null, total = 0, correct = 0;
let difficulty = 'easy', currentTopic = 'vertex';
const FC_TOPICS = new Set(['gcf','trinomial','diff2','leada']);

function pick(arr){ return arr[Math.floor(Math.random()*arr.length)]; }
function rnd(a,b){ return Math.floor(Math.random()*(b-a+1))+a; }
function sign(n){ return n>=0?'+':'-'; }
function abs(n){ return Math.abs(n); }
function fmt(n){ return n<0?`(${n})`:String(n); }
function gcd(a,b){ a=Math.abs(a);b=Math.abs(b);while(b){[a,b]=[b,a%b];}return a; }

// ── Helpers to write expressions ─────────────────────────────────────────────
function showQ(a,h,k){
  // a(x-h)²+k  nicely formatted
  const aStr = a===1?'':(a===-1?'-':`${a}`);
  const hStr = h===0?'':(h>0?` - ${h}`:` + ${abs(h)}`);
  const kStr = k===0?'':(k>0?` + ${k}`:` - ${abs(k)}`);
  return `y = ${aStr}(x${hStr})²${kStr}`;
}
function showStd(a,b,c){
  const aStr = a===1?'x²':(a===-1?'-x²':`${a}x²`);
  const bStr = b===0?'':(b>0?` + ${b}x`:` - ${abs(b)}x`);
  const cStr = c===0?'':(c>0?` + ${c}`:` - ${abs(c)}`);
  return `y = ${aStr}${bStr}${cStr}`;
}

// ── Examples ──────────────────────────────────────────────────────────────────
const examples = {
  vertex:{
    problem:'Identify the vertex, axis of symmetry, and direction of opening:\n  y = -2(x - 3)² + 5',
    steps:[
      ['Vertex form','y = a(x - h)² + k,  vertex = (h, k)'],
      ['Read h and k','h = 3,  k = 5  →  vertex = (3, 5)'],
      ['Axis of symmetry','x = h  →  x = 3'],
      ['Direction','a = -2 < 0  →  opens downward'],
    ],
    answer:'Vertex: (3, 5)  |  Axis: x = 3  |  Opens: downward'
  },
  stretch:{
    problem:'Compare y = 3(x)² to the parent y = x².\nDescribe the transformation.',
    steps:[
      ['Identify a','a = 3'],
      ['|a| > 1','Vertical stretch by factor of 3'],
      ['a > 0','No reflection (opens upward)'],
    ],
    answer:'Vertical stretch by a factor of 3; opens upward'
  },
  shift:{
    problem:'Describe the transformation from y = x² to:\n  y = (x + 4)² - 7',
    steps:[
      ['Horizontal shift','(x + 4) → h = -4  →  shift LEFT 4'],
      ['Vertical shift','k = -7  →  shift DOWN 7'],
    ],
    answer:'Shift left 4, shift down 7'
  },
  grapheq:{
    problem:'A parabola has vertex (-2, 5) and passes through (0, 1).\nWrite its equation in vertex form.',
    steps:[
      ['Start with vertex form','y = a(x - (-2))² + 5 = a(x + 2)² + 5'],
      ['Plug in (0, 1)','1 = a(0 + 2)² + 5  →  1 = 4a + 5'],
      ['Solve for a','4a = -4  →  a = -1'],
      ['Write equation','y = -(x + 2)² + 5'],
    ],
    answer:'y = -(x + 2)² + 5'
  },
  gcf:{
    problem:'Factor completely:\n  6x³ + 9x² - 12x',
    steps:[
      ['Find GCF','GCF of 6, 9, 12 = 3; lowest power of x = x¹\nGCF = 3x'],
      ['Divide each term','6x³÷3x = 2x²,  9x²÷3x = 3x,  -12x÷3x = -4'],
      ['Write factored form','3x(2x² + 3x - 4)'],
    ],
    answer:'3x(2x² + 3x - 4)'
  },
  trinomial:{
    problem:'Factor:\n  x² + 7x + 12',
    steps:[
      ['Find two numbers','Multiply to 12 AND add to 7\n3 × 4 = 12  ✓   3 + 4 = 7  ✓'],
      ['Write factors','(x + 3)(x + 4)'],
    ],
    answer:'(x + 3)(x + 4)'
  },
  diff2:{
    problem:'Factor:\n  x² - 49',
    steps:[
      ['Recognize pattern','a² - b² = (a + b)(a - b)\nx² - 49 = x² - 7²'],
      ['Apply formula','(x + 7)(x - 7)'],
    ],
    answer:'(x + 7)(x - 7)'
  },
  leada:{
    problem:'Factor:\n  2x² + 7x + 3',
    steps:[
      ['AC method','a×c = 2×3 = 6\nFind two numbers that multiply to 6 and add to 7:\n1 and 6'],
      ['Rewrite middle term','2x² + x + 6x + 3'],
      ['Group','x(2x + 1) + 3(2x + 1)'],
      ['Factor out common binomial','(2x + 1)(x + 3)'],
    ],
    answer:'(2x + 1)(x + 3)'
  }
};

// ── Generators ────────────────────────────────────────────────────────────────
const topics = {

  vertex:{
    label:'Vertex Form', group:'qt',
    gen(d){
      const hR = d==='easy'?[-3,3]:d==='medium'?[-6,6]:[-9,9];
      const kR = d==='easy'?[-5,5]:d==='medium'?[-9,9]:[-15,15];
      const aOpts = d==='easy'?[1,-1]:d==='medium'?[1,-1,2,-2]:[1,-1,2,-2,3,-3];
      const a=pick(aOpts), h=rnd(hR[0],hR[1]), k=rnd(kR[0],kR[1]);
      const dir = a>0?'upward':'downward';
      const eq = showQ(a,h,k);
      const text = `Identify the vertex, axis of symmetry, and direction of opening:\n  ${eq}`;
      const answers = [`(${h}, ${k})`, `x=${h}`, dir];
      const hint = `Vertex form: y = a(x−h)² + k\nVertex = (h, k) = (${h}, ${k})\nAxis: x = ${h}\na = ${a}: opens ${dir}`;
      return {text, answers, hint, multi:true,
              labels:['Vertex (h,k):','Axis x =','Opens:'],
              phs:['e.g. (2,-3)','e.g. 1','upward/downward']};
    }
  },

  stretch:{
    label:'Stretch / Compress / Reflect', group:'qt',
    gen(d){
      const aOpts = d==='easy'?[2,3,1/2]:d==='medium'?[2,3,4,1/2,1/3,-1,-2]:[-2,-3,2,3,4,5,1/2,1/3,-1/2];
      const a = pick(aOpts);
      const aFmt = Number.isInteger(a)?String(a):`1/${Math.round(1/a)}`;
      const parent = `y = x²`;
      let desc;
      const absA = Math.abs(a);
      const stretch = absA>1?`vertical stretch by factor ${aFmt}`:`vertical compression by factor ${aFmt}`;
      const reflect = a<0?' and reflection over x-axis':'';
      desc = stretch + reflect;
      const eq = `y = ${aFmt}x²`;
      const text = `Compare to the parent function y = x².\nDescribe the transformation:\n  ${eq}`;
      const hints = `|a| = ${aFmt}: ${absA>1?'stretch (>1)':'compression (<1)'}${a<0?'\na < 0: reflection over x-axis':''}`;
      return {text, answers:[desc], hint:hints, multi:false};
    }
  },

  shift:{
    label:'Shifts (Translations)', group:'qt',
    gen(d){
      const r = d==='easy'?5:d==='medium'?9:14;
      const h=rnd(-r,r), k=rnd(-r,r);
      const a = d==='hard'?pick([1,-1,2,-2]):1;
      const eq = showQ(a,h,k);
      let parts = [];
      if(h!==0) parts.push(h<0?`right ${abs(h)}`:`left ${h}`);
      if(k!==0) parts.push(k<0?`down ${abs(k)}`:`up ${k}`);
      if(a===-1) parts.push('reflect over x-axis');
      else if(a!=1) parts.push(`vertical ${abs(a)>1?'stretch':'compression'} by ${abs(a)}`);
      if(parts.length===0) parts=['no shift (same as parent)'];
      const ans = parts.join(', ');
      const text = `Describe the transformation(s) from y = x² to:\n  ${eq}`;
      const hint = `h = ${h}: shift ${h<0?`right ${abs(h)}`:`left ${abs(h)}`}\nk = ${k}: shift ${k<0?`down ${abs(k)}`:`up ${abs(k)}`}${a!==1?`\na = ${a}: stretch/reflect`:''}`;
      return {text, answers:[ans], hint, multi:false, freetext:true};
    }
  },

  grapheq:{
    label:'Graph → Equation', group:'qt',
    gen(d){
      const r = d==='easy'?3:d==='medium'?5:7;
      const h=rnd(-r,r), k=rnd(-r,r);
      const aOpts = d==='easy'?[1,-1]:d==='medium'?[1,-1,2,-2]:[1,-1,2,-2,3,-3,1/2];
      const a=pick(aOpts);
      const aFmt = Number.isInteger(a)?String(a):`1/${Math.round(1/a)}`;
      // make a point on the parabola
      const dx = rnd(1,3)*pick([-1,1]);
      const px = h+dx;
      const py = a*dx*dx+k;
      const eq = showQ(a,h,k);
      const text = `Write the equation in vertex form.\nVertex: (${h}, ${k})\nPasses through point: (${px}, ${py})`;
      const ans = eq;
      const hint = `Start: y = a(x - ${h})² + ${k}\nSub (${px}, ${py}): ${py} = a(${px}-${h})² + ${k}\nSolve: a = ${aFmt}`;
      return {text, answers:[ans], hint, multi:false};
    }
  },

  gcf:{
    label:'GCF', group:'fc',
    gen(d){
      const g = d==='easy'?pick([2,3,4,5]):d==='medium'?pick([2,3,4,5,6]):pick([3,4,5,6,7,8]);
      const xp = d==='easy'?1:d==='medium'?pick([1,2]):pick([1,2,3]);
      const terms = d==='easy'?2:3;
      const cs = Array.from({length:terms},()=>rnd(1,5)*g);
      const pows = Array.from({length:terms},(_,i)=>xp+i);
      let expr = cs.map((c,i)=>{
        const p=pows[i];
        const coe = c/g;
        const xstr = p===0?'':(p===1?'x':`x${sup(p)}`);
        return `${c}${xstr}`;
      }).join(' + ');
      let inner = cs.map((c,i)=>{
        const p=pows[i];
        const coe = c/g;
        const xstr = p===xp?'':(p-xp===1?'x':`x${sup(p-xp)}`);
        return `${coe}${xstr}`;
      }).join(' + ');
      const gcfStr = g + (xp>0?(xp===1?'x':`x${sup(xp)}`):'');
      const ans = `${gcfStr}(${inner})`;
      const text = `Factor out the GCF completely:\n  ${expr}`;
      const hint = `GCF of coefficients ${cs.join(', ')} = ${g}\nLowest power of x = x${sup(xp)}\nGCF = ${gcfStr}`;
      return {text, answers:[ans], hint, multi:false};
    }
  },

  trinomial:{
    label:'Trinomial x²+bx+c', group:'fc',
    gen(d){
      const r = d==='easy'?[-4,4]:d==='medium'?[-7,7]:[-10,10];
      let r1,r2,tries=0;
      do{ r1=rnd(r[0],r[1]); r2=rnd(r[0],r[1]); tries++; }
      while(r1===0||r2===0||tries<20);
      const b=-(r1+r2), c=r1*r2;
      const bStr=b===0?'':(b>0?` + ${b}x`:` - ${abs(b)}x`);
      const cStr=c===0?'':(c>0?` + ${c}`:` - ${abs(c)}`);
      const f1 = r1>0?`(x - ${r1})`:`(x + ${abs(r1)})`;
      const f2 = r2>0?`(x - ${r2})`:`(x + ${abs(r2)})`;
      const ans = f1+f2;
      const text = `Factor completely:\n  x²${bStr}${cStr}`;
      const hint = `Find two numbers that multiply to ${c} and add to ${b}.\nThose numbers: ${-r1} and ${-r2}`;
      return {text, answers:[ans, f2+f1], hint, multi:false};
    }
  },

  diff2:{
    label:'Difference of Squares', group:'fc',
    gen(d){
      const nOpts = d==='easy'?[1,4,9,16,25]:d==='medium'?[1,4,9,16,25,36,49]:[1,4,9,16,25,36,49,64,81,100];
      const aOpts = d==='easy'?[1]:d==='medium'?[1,4,9]:[1,4,9,25];
      const a2=pick(aOpts), b2=pick(nOpts.filter(n=>n!==a2));
      const a=Math.sqrt(a2), b=Math.sqrt(b2);
      const aStr = a===1?'x':`${a}x`;
      const aStr2 = a===1?'x²':`${a2}x²`;
      const expr = `${aStr2} - ${b2}`;
      const ans = `(${aStr} + ${b})(${aStr} - ${b})`;
      const text = `Factor:\n  ${expr}`;
      const hint = `Pattern: a² - b² = (a+b)(a-b)\na = ${aStr},  b = ${b}`;
      return {text, answers:[ans, `(${aStr} - ${b})(${aStr} + ${b})`], hint, multi:false};
    }
  },

  leada:{
    label:'ax²+bx+c (a≠1)', group:'fc',
    gen(d){
      const aOpts = d==='easy'?[2,3]:d==='medium'?[2,3,4,5]:[2,3,4,5,6];
      let a=pick(aOpts), r1,r2,tries=0;
      const r = d==='easy'?[-3,3]:d==='medium'?[-5,5]:[-7,7];
      do{ r1=rnd(r[0],r[1]); r2=rnd(r[0],r[1]); tries++; }
      while(r1===0||r2===0||r1===r2||tries<30);
      // ax²+bx+c = a(x-r1)(x-r2) expanded... but let's use nice factored pairs
      // Instead: (px+q)(sx+t) style — pick factor pairs of a
      const pairs = [[1,a],[a,1]];
      if(a%2===0) pairs.push([2,a/2]);
      if(a%3===0) pairs.push([3,a/3]);
      const [p,s]=pick(pairs);
      const q=rnd(r[0],r[1]), t=rnd(r[0],r[1]);
      const B=p*t+s*q, C=q*t;
      const A=p*s;
      const bStr=B===0?'':(B>0?` + ${B}x`:` - ${abs(B)}x`);
      const cStr=C===0?'':(C>0?` + ${C}`:` - ${abs(C)}`);
      const f1str=q===0?`${p}x`:(q>0?`(${p}x + ${q})`:`(${p}x - ${abs(q)})`);
      const f2str=t===0?`${s}x`:(t>0?`(${s}x + ${t})`:`(${s}x - ${abs(t)})`);
      const ans=f1str+f2str;
      const text=`Factor completely:\n  ${A}x²${bStr}${cStr}`;
      const prod=A*C;
      const hint=`AC method: a×c = ${A}×${C} = ${prod}\nFind two numbers that multiply to ${prod} and add to ${B}.\nThen factor by grouping.`;
      return {text, answers:[ans, f2str+f1str], hint, multi:false};
    }
  }
};

function sup(n){ return n===2?'²':n===3?'³':n===4?'⁴':`^${n}`; }

// ── UI ────────────────────────────────────────────────────────────────────────
let multiInputs = [];

function setTopic(key, btn){
  currentTopic = key;
  document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  const isFc = FC_TOPICS.has(key);
  document.getElementById('new-btn').className = `btn btn-primary${isFc?' fc-active':''}`;
  document.getElementById('check-btn').className = `btn btn-primary${isFc?' fc-active':''}`;
  closeExample();
  newProblem();
}

function setDiff(d){
  difficulty=d;
  document.querySelectorAll('.diff-btn').forEach(b=>b.classList.remove('active'));
  document.querySelector('.diff-btn.'+d).classList.add('active');
  newProblem();
}

function newProblem(){
  current = topics[currentTopic].gen(difficulty);
  const isFc = FC_TOPICS.has(currentTopic);

  // badges
  const bt = document.getElementById('badge-topic');
  bt.textContent = topics[currentTopic].label;
  bt.className = `badge badge-${isFc?'fc':'qt'}`;
  const bd = document.getElementById('badge-diff');
  bd.className = `badge badge-${difficulty}`;
  bd.textContent = difficulty.charAt(0).toUpperCase()+difficulty.slice(1);

  document.getElementById('prob').innerText = current.text;
  document.getElementById('feedback').className = 'feedback';
  document.getElementById('hint').style.display = 'none';
  document.getElementById('hint-link').style.display = 'inline';

  const row = document.getElementById('input-row-container') || document.querySelector('.input-row');

  if(current.multi){
    // Multi-field input (vertex form)
    row.innerHTML = '';
    multiInputs = [];
    current.labels.forEach((lbl,i)=>{
      const wrap = document.createElement('div');
      wrap.style.cssText = 'display:flex;align-items:center;gap:8px;margin-bottom:8px;';
      const l = document.createElement('span');
      l.textContent = lbl;
      l.style.cssText = 'font-size:15px;font-weight:500;min-width:110px;';
      const inp = document.createElement('input');
      inp.className='answer-input';
      inp.placeholder=current.phs[i];
      inp.style.maxWidth='180px';
      inp.id=`multi-${i}`;
      inp.onkeydown=e=>{if(e.key==='Enter')checkAnswer();};
      wrap.appendChild(l);
      wrap.appendChild(inp);
      row.appendChild(wrap);
      multiInputs.push(inp);
    });
    const btn = document.createElement('button');
    btn.className=`btn btn-primary${isFc?' fc-active':''}`;
    btn.textContent='✓ Check';
    btn.onclick=checkAnswer;
    row.appendChild(btn);
    if(multiInputs[0]) multiInputs[0].focus();
  } else {
    row.innerHTML = `
      <input class="answer-input" id="ans" placeholder="Type your answer" onkeydown="if(event.key==='Enter')checkAnswer()">
      <button class="btn btn-primary${isFc?' fc-active':''}" onclick="checkAnswer()">✓ Check</button>`;
    document.getElementById('ans').focus();
  }
}

function normalize(s){
  return s.trim().toLowerCase()
    .replace(/\s+/g,'').replace(/×/g,'*')
    .replace(/²/g,'^2').replace(/³/g,'^3')
    .replace(/\(/g,'(').replace(/\)/g,')')
    .replace(/upwards/,'upward').replace(/downwards/,'downward');
}

function checkAnswer(){
  if(!current) return;
  total++;
  const fb = document.getElementById('feedback');
  let ok = false;

  if(current.multi){
    const got = multiInputs.map(i=>normalize(i.value));
    const exp = current.answers.map(a=>normalize(String(a)));
    ok = exp.every((e,i)=>got[i]===e||got[i].includes(e)||e.includes(got[i]));
  } else {
    const raw = (document.getElementById('ans')||{value:''}).value.trim();
    if(!raw){ total--; return; }
    const got = normalize(raw);
    ok = current.answers.some(a=>normalize(String(a))===got||
         got.replace(/[()]/g,'')===normalize(String(a)).replace(/[()]/g,''));
    // partial match for free-text shifts
    if(!ok && current.freetext){
      const expWords = normalize(current.answers[0]).split(/[\s,]+/);
      const gotWords = got.split(/[\s,]+/);
      ok = expWords.every(w=>gotWords.some(g=>g.includes(w)||w.includes(g)));
    }
  }

  if(ok) correct++;
  updateStats();
  fb.className = 'feedback '+(ok?'correct':'wrong');
  fb.innerHTML = ok ? '✓ Correct!' : `✗ Not quite.  Answer: ${current.answers[0]}`;
}

function showHint(){
  document.getElementById('hint').style.display='block';
  document.getElementById('hint').textContent=current.hint;
  document.getElementById('hint-link').style.display='none';
}

function toggleExample(){
  const p=document.getElementById('example-panel');
  if(p.classList.contains('open')){closeExample();return;}
  const ex=examples[currentTopic];
  document.getElementById('ex-problem').innerText=ex.problem;
  const ul=document.getElementById('ex-steps'); ul.innerHTML='';
  ex.steps.forEach(([l,t])=>{
    const li=document.createElement('li');
    li.innerHTML=`<span class="step-lbl">${l}</span>${t.replace(/\n/g,'<br>')}`;
    ul.appendChild(li);
  });
  document.getElementById('ex-answer').innerText=ex.answer;
  p.classList.add('open');
}
function closeExample(){ document.getElementById('example-panel').classList.remove('open'); }

function updateStats(){
  document.getElementById('s-total').textContent=total;
  document.getElementById('s-correct').textContent=correct;
  document.getElementById('s-pct').textContent=total?Math.round(correct/total*100)+'%':'—';
}
function resetStats(){ total=0; correct=0; updateStats(); newProblem(); }

